# Copia este archivo como .env y configura tus valores

# APIs del backend
VITE_API_ENDPOINT_USERS=http://localhost:8080/api/v1/any/user
VITE_API_ENDPOINT_LOGIN=http://localhost:8080/api/v1/all/login
VITE_API_ENDPOINT_LEGAL=http://localhost:8080/api/v1/any/legal
VITE_API_ENDPOINT_REFRESH_TOKEN=http://localhost:8080/api/v1/all/token

# Credenciales de Google OAuth
# Obtener en: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Credenciales de Facebook
# Obtener en: https://developers.facebook.com
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Otros endpoints del backend
VITE_API_ENDPOINT_GENERAL=http://localhost:8080/api/v1/any
VITE_API_ENDPOINT_POSTS=http://localhost:8080/api/v1/any/post
VITE_API_ENDPOINT_IMAGES=http://localhost:8080/api/v1/any/image
VITE_API_ENDPOINT_REPLIES=http://localhost:8080/api/v1/any/reply
VITE_API_ENDPOINT_TAGS=http://localhost:8080/api/v1/any/tag
VITE_API_ENDPOINT_TEXTS=http://localhost:8080/api/v1/any/text
VITE_API_ENDPOINT_PROFILE=http://localhost:8080/api/v1/any/profile
