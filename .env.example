# Configuración de ejemplo para el proyecto Ágora
# Copia este archivo a .env y configura los valores reales
# 
# 🚀 Para desarrolladores que hacen fork:
# 1. Copia este archivo como .env
# 2. Ajusta las URLs según tu backend
# 3. Configura las claves de servicios externos
# 4. Para desarrollo local, usa los valores por defecto (localhost:8080)


# ===== CONFIGURACIÓN BASE =====
# URL base del API - Cambiar según tu servidor backend
VITE_API_ENDPOINT_GENERAL=http://localhost:8080/api/v1

# ===== AUTENTICACIÓN =====
# Endpoints para login/logout y manejo de tokens
VITE_API_ENDPOINT_LOGIN=http://localhost:8080/api/v1/all/login
VITE_API_ENDPOINT_LOGOUT=http://localhost:8080/api/v1/all/logout
VITE_API_ENDPOINT_REFRESH_TOKEN=http://localhost:8080/api/v1/all/token

# ===== RECUPERACIÓN DE CONTRASEÑA =====
# Endpoints para reset de contraseñas (usuarios y admins)
VITE_API_ENDPOINT_USER_PASSWORD_RECOVERY_REQUEST=http://localhost:8080/api/v1/user/password/recovery-request
VITE_API_ENDPOINT_USER_PASSWORD_RESET=http://localhost:8080/api/v1/user/password/reset
VITE_API_ENDPOINT_ADMIN_PASSWORD_RECOVERY_REQUEST=http://localhost:8080/api/v1/admin/password/recovery-request
VITE_API_ENDPOINT_ADMIN_PASSWORD_RESET=http://localhost:8080/api/v1/admin/password/reset

# ===== GESTIÓN DE USUARIOS =====
# Endpoints para registro, perfiles y avatares
VITE_API_ENDPOINT_USERS=http://localhost:8080/api/v1/any/user
VITE_API_ENDPOINT_REGISTER=http://localhost:8080/api/v1/all/register
VITE_API_ENDPOINT_PROFILE=http://localhost:8080/api/v1/any/user/profile
VITE_API_ENDPOINT_AVATARS=http://localhost:8080/api/v1/any/avatars

# ===== ADMINISTRACIÓN =====
# Endpoints para gestión de administradores y baneos
VITE_API_ENDPOINT_ADMIN_PROFILE=http://localhost:8080/api/v1/admin/profile
VITE_API_ENDPOINT_ADMIN_CREATE=http://localhost:8080/api/v1/admin/create
VITE_API_ENDPOINT_ADMIN_LIST=http://localhost:8080/api/v1/admin
VITE_API_ENDPOINT_ADMIN_DEMOTE=http://localhost:8080/api/v1/admin/demote
VITE_API_ENDPOINT_BANNED=http://localhost:8080/api/v1/admin/banned

# ===== CONTENIDO LEGAL =====
# Endpoints para términos, privacidad, cookies y reglas del blog
VITE_API_ENDPOINT_LEGAL=http://localhost:8080/api/v1/legal

# ===== POSTS Y CONTENIDO =====
# Endpoints para posts, comentarios, favoritos y multimedia
VITE_API_ENDPOINT_POSTS=http://localhost:8080/api/v1/posts
VITE_API_ENDPOINT_POST_IMAGES=http://localhost:8080/api/v1/post-images
VITE_API_ENDPOINT_REPLIES=http://localhost:8080/api/v1/any/replies
VITE_API_ENDPOINT_COMMENTS=http://localhost:8080/api/v1/comments
VITE_API_ENDPOINT_FAVORITE=http://localhost:8080/api/v1/any/favorites

# ===== SISTEMA DE TAGS =====
# Endpoints para gestión de etiquetas (posts y eventos)
VITE_API_ENDPOINT_TAGS=http://localhost:8080/api/v1/any/tags
VITE_API_ENDPOINT_TAGS_BY_EVENT_PUBLIC=http://localhost:8080/api/v1/all/tags
VITE_API_ENDPOINT_TAGS_BY_EVENT_PRIVATE=http://localhost:8080/api/v1/any/tags
VITE_API_ENDPOINT_TAGS_POST=http://localhost:8080/api/v1/any/tags/posts
VITE_API_ENDPOINT_EVENT_TAGS=http://localhost:8080/api/v1/any/tags
VITE_API_ENDPOINT_POST_TAGS=http://localhost:8080/api/v1/any/tags

# ===== MULTIMEDIA Y RECURSOS =====
# Endpoints para imágenes y textos
VITE_API_ENDPOINT_IMAGES=http://localhost:8080/api/v1/any/images
VITE_API_ENDPOINT_TEXTS=http://localhost:8080/api/v1/all/texts

# ===== EVENTOS =====
# Endpoints para eventos, asistentes e imágenes de eventos
VITE_API_ENDPOINT_EVENTS=http://localhost:8080/api/v1/events
VITE_API_ENDPOINT_EVENTS_PUBLIC=http://localhost:8080/api/v1/public/events
VITE_API_ENDPOINT_EVENT_IMAGES=http://localhost:8080/api/v1/any/event-images
VITE_API_ENDPOINT_EVENT_IMAGES_PUBLIC=http://localhost:8080/api/v1/all/event-images
VITE_API_ENDPOINT_ATTENDEES=http://localhost:8080/api/v1/attendees

# ===== SERVICIOS ADICIONALES =====
# Endpoints para salud del sistema, configuración y moderación
VITE_API_ENDPOINT_HEALTH=http://localhost:8080/api/v1/all/health
VITE_API_ENDPOINT_PUBLIC_SETTINGS=http://localhost:8080/api/v1/public/settings
VITE_API_ENDPOINT_MODERATION=http://localhost:8080/api/v1/moderation
VITE_API_ENDPOINT_EXPORT=http://localhost:8080/api/v1/export
VITE_API_ENDPOINT_ALERTS=http://localhost:8080/api/v1/alerts
VITE_API_ENDPOINT_NOTIFICATIONS=http://localhost:8080/api/v1/notifications

# ===== AUTENTICACIÓN SOCIAL =====
# Endpoints para login con Google y Facebook
VITE_API_ENDPOINT_GOOGLE_AUTH=http://localhost:8080/api/v1/all/auth/login/google
VITE_API_ENDPOINT_FACEBOOK_AUTH=http://localhost:8080/api/v1/all/auth/login/facebook

# ===== CONFIGURACIÓN DE GOOGLE OAUTH =====
# 🔑 IMPORTANTE: Obtén estas claves en Google Cloud Console
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita la Google+ API
# 4. Crea credenciales OAuth 2.0
# 5. Configura las URLs de redirección autorizadas
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===== CONFIGURACIÓN DE reCAPTCHA =====
# 🛡️ IMPORTANTE: Obtén estas claves en Google reCAPTCHA
# 1. Ve a https://www.google.com/recaptcha/admin
# 2. Registra tu sitio web
# 3. Selecciona reCAPTCHA v2 o v3 según tus necesidades
# 4. Obtén la clave del sitio (Site Key)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ===== CONFIGURACIÓN DE DESARROLLO =====
# Variables para el entorno de desarrollo
VITE_NODE_ENV=development
VITE_DEBUG=true

# ===== CONFIGURACIÓN DE LOGGING =====
# Sistema de logs para depuración y monitoreo
VITE_LOG_LEVEL=DEBUG
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_REMOTE_LOGGING=false
VITE_MASK_SENSITIVE_DATA=true
VITE_MAX_LOG_SIZE=1000
VITE_LOGGING_ENDPOINT=http://localhost:8080/api/v1/admin/logs

# ===== NOTAS PARA DESARROLLADORES =====
# 📝 Backend requerido:
#    - Spring Boot con API REST
#    - Base de datos (MySQL/PostgreSQL recomendado)
#    - Sistema de autenticación JWT
#    - Endpoints documentados en Swagger
#
# 🔧 Para desarrollo local:
#    - Clona el repositorio del backend
#    - Configura la base de datos
#    - Ejecuta el backend en puerto 8080
#    - Ajusta las URLs si usas puertos diferentes
#
# 🚀 Para producción:
#    - Cambia todas las URLs de localhost a tu dominio
#    - Configura HTTPS
#    - Obtén claves reales de Google OAuth y reCAPTCHA
#    - Habilita logging remoto si es necesario
#
# 📚 Documentación adicional:
#    - README.md del proyecto
#    - Documentación del API en Swagger
#    - Guías de instalación específicas por entorno
