# =====================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO - ÁGORA PROJECT
# =====================================================
# 
# ⚠️  IMPORTANTE - SEGURIDAD:
# Este archivo es público en GitHub. NUNCA coloques:
# - URLs reales de producción
# - Claves API reales
# - Tokens o secretos
# - Información sensible
#
# 🔧 INSTRUCCIONES DE USO:
# 1. Copia este archivo como .env.local
# 2. Reemplaza TODOS los valores con tus configuraciones reales
# 3. Configura tu backend y obtén las URLs reales
# 4. El archivo .env.local está en .gitignore (no se sube a GitHub)

# ===== CONFIGURACIÓN BASE =====
# URL base de tu servidor backend
VITE_API_ENDPOINT_GENERAL=YOUR_BACKEND_URL_HERE

# ===== AUTENTICACIÓN =====
VITE_API_ENDPOINT_LOGIN=YOUR_BACKEND_URL_HERE/login
VITE_API_ENDPOINT_LOGOUT=YOUR_BACKEND_URL_HERE/logout
VITE_API_ENDPOINT_REFRESH_TOKEN=YOUR_BACKEND_URL_HERE/refresh

# ===== USUARIOS Y PERFILES =====
VITE_API_ENDPOINT_USERS=YOUR_BACKEND_URL_HERE/users
VITE_API_ENDPOINT_REGISTER=YOUR_BACKEND_URL_HERE/register
VITE_API_ENDPOINT_PROFILE=YOUR_BACKEND_URL_HERE/profile
VITE_API_ENDPOINT_AVATARS=YOUR_BACKEND_URL_HERE/avatars

# ===== RECUPERACIÓN DE CONTRASEÑA =====
VITE_API_ENDPOINT_USER_PASSWORD_RECOVERY_REQUEST=YOUR_BACKEND_URL_HERE/password/recovery
VITE_API_ENDPOINT_USER_PASSWORD_RESET=YOUR_BACKEND_URL_HERE/password/reset
VITE_API_ENDPOINT_ADMIN_PASSWORD_RECOVERY_REQUEST=YOUR_BACKEND_URL_HERE/admin/password/recovery
VITE_API_ENDPOINT_ADMIN_PASSWORD_RESET=YOUR_BACKEND_URL_HERE/admin/password/reset

# ===== ADMINISTRACIÓN =====
VITE_API_ENDPOINT_ADMIN_PROFILE=YOUR_BACKEND_URL_HERE/admin/profile
VITE_API_ENDPOINT_ADMIN_CREATE=YOUR_BACKEND_URL_HERE/admin/create
VITE_API_ENDPOINT_ADMIN_LIST=YOUR_BACKEND_URL_HERE/admin/list
VITE_API_ENDPOINT_ADMIN_DEMOTE=YOUR_BACKEND_URL_HERE/admin/demote
VITE_API_ENDPOINT_BANNED=YOUR_BACKEND_URL_HERE/admin/banned

# ===== CONTENIDO LEGAL =====
VITE_API_ENDPOINT_LEGAL=YOUR_BACKEND_URL_HERE/legal

# ===== POSTS Y CONTENIDO =====
VITE_API_ENDPOINT_POSTS=YOUR_BACKEND_URL_HERE/posts
VITE_API_ENDPOINT_POST_IMAGES=YOUR_BACKEND_URL_HERE/post-images
VITE_API_ENDPOINT_REPLIES=YOUR_BACKEND_URL_HERE/replies
VITE_API_ENDPOINT_COMMENTS=YOUR_BACKEND_URL_HERE/comments
VITE_API_ENDPOINT_FAVORITE=YOUR_BACKEND_URL_HERE/favorites

# ===== SISTEMA DE TAGS =====
VITE_API_ENDPOINT_TAGS=YOUR_BACKEND_URL_HERE/tags
VITE_API_ENDPOINT_TAGS_BY_EVENT_PUBLIC=YOUR_BACKEND_URL_HERE/tags/events/public
VITE_API_ENDPOINT_TAGS_BY_EVENT_PRIVATE=YOUR_BACKEND_URL_HERE/tags/events/private
VITE_API_ENDPOINT_TAGS_POST=YOUR_BACKEND_URL_HERE/tags/posts
VITE_API_ENDPOINT_EVENT_TAGS=YOUR_BACKEND_URL_HERE/events/tags
VITE_API_ENDPOINT_POST_TAGS=YOUR_BACKEND_URL_HERE/posts/tags

# ===== MULTIMEDIA Y RECURSOS =====
VITE_API_ENDPOINT_IMAGES=YOUR_BACKEND_URL_HERE/images
VITE_API_ENDPOINT_TEXTS=YOUR_BACKEND_URL_HERE/texts
VITE_API_ENDPOINT_TEXT_IMAGES=YOUR_BACKEND_URL_HERE/text-images

# ===== EVENTOS =====
VITE_API_ENDPOINT_EVENTS=YOUR_BACKEND_URL_HERE/events
VITE_API_ENDPOINT_EVENTS_PUBLIC=YOUR_BACKEND_URL_HERE/events/public
VITE_API_ENDPOINT_EVENT_IMAGES=YOUR_BACKEND_URL_HERE/event-images
VITE_API_ENDPOINT_EVENT_IMAGES_PUBLIC=YOUR_BACKEND_URL_HERE/event-images/public
VITE_API_ENDPOINT_ATTENDEES=YOUR_BACKEND_URL_HERE/attendees

# ===== SERVICIOS ADICIONALES =====
VITE_API_ENDPOINT_HEALTH=YOUR_BACKEND_URL_HERE/health
VITE_API_ENDPOINT_PUBLIC_SETTINGS=YOUR_BACKEND_URL_HERE/settings
VITE_API_ENDPOINT_MODERATION=YOUR_BACKEND_URL_HERE/moderation
VITE_API_ENDPOINT_EXPORT=YOUR_BACKEND_URL_HERE/export
VITE_API_ENDPOINT_ALERTS=YOUR_BACKEND_URL_HERE/alerts
VITE_API_ENDPOINT_NOTIFICATIONS=YOUR_BACKEND_URL_HERE/notifications

# ===== AUTENTICACIÓN SOCIAL =====
VITE_API_ENDPOINT_GOOGLE_AUTH=YOUR_BACKEND_URL_HERE/auth/google
# VITE_API_ENDPOINT_FACEBOOK_AUTH=YOUR_BACKEND_URL_HERE/auth/facebook  # COMENTADO

# ===== CONFIGURACIÓN DE GOOGLE OAUTH =====
# 🔑 Obtén estas claves en: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===== CONFIGURACIÓN DE FACEBOOK OAUTH (DESHABILITADO) =====
# 🔑 Para el futuro: https://developers.facebook.com/
# VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
# VITE_FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# ===== CONFIGURACIÓN DE GOOGLE MAPS =====
# 🗺️ Obtén tu API key en: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===== CONFIGURACIÓN DE reCAPTCHA =====
# 🛡️ Obtén tu site key en: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# ===== CONFIGURACIÓN DE DESARROLLO =====
VITE_NODE_ENV=development
VITE_DEBUG=true

# ===== CONFIGURACIÓN DE LOGGING =====
VITE_LOG_LEVEL=DEBUG
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_REMOTE_LOGGING=false
VITE_MASK_SENSITIVE_DATA=true
VITE_MAX_LOG_SIZE=1000
VITE_LOGGING_ENDPOINT=YOUR_BACKEND_URL_HERE/logs

# =====================================================
# NOTAS DE SEGURIDAD Y CONFIGURACIÓN
# =====================================================
#
# 🚨 IMPORTANTE PARA DESARROLLADORES:
# 
# 1. NUNCA subas archivos .env reales a GitHub
# 2. Este archivo .env.example es público - solo placeholders
# 3. Crea tu archivo .env.local con valores reales
# 4. Verifica que .env.local esté en .gitignore
#
# 📝 CONFIGURACIÓN REQUERIDA:
# 
# Backend:
# - API REST funcional
# - Autenticación JWT
# - Base de datos configurada
# - CORS habilitado para tu dominio
#
# Servicios externos:
# - Google Cloud Console (OAuth + Maps)
# - reCAPTCHA de Google
# - (Opcional) Facebook Developers
#
# � DESARROLLO LOCAL:
# 
# 1. Configura tu backend local
# 2. Reemplaza YOUR_BACKEND_URL_HERE con tu URL real
# 3. Obtén claves de Google y reCAPTCHA
# 4. Copia como .env.local y completa
#
# � PRODUCCIÓN:
# 
# 1. URLs HTTPS obligatorias
# 2. Claves de producción reales
# 3. Variables de entorno del servidor
# 4. Monitoreo y logging habilitado
